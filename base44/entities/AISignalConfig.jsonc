{
  "name": "AISignalConfig",
  "type": "object",
  "properties": {
    "config_name": {
      "type": "string",
      "description": "Name of this signal configuration"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this config is active"
    },
    "data_sources": {
      "type": "object",
      "properties": {
        "technical_indicators": {
          "type": "boolean",
          "default": true
        },
        "news_sentiment": {
          "type": "boolean",
          "default": true
        },
        "social_media": {
          "type": "boolean",
          "default": true
        },
        "on_chain_data": {
          "type": "boolean",
          "default": true
        },
        "predictive_models": {
          "type": "boolean",
          "default": true
        },
        "anomaly_detection": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Enabled data sources"
    },
    "weights": {
      "type": "object",
      "properties": {
        "technical": {
          "type": "number",
          "default": 30,
          "description": "Weight percentage for technical analysis (0-100)"
        },
        "news": {
          "type": "number",
          "default": 20,
          "description": "Weight percentage for news sentiment (0-100)"
        },
        "social": {
          "type": "number",
          "default": 15,
          "description": "Weight percentage for social media (0-100)"
        },
        "onchain": {
          "type": "number",
          "default": 20,
          "description": "Weight percentage for on-chain data (0-100)"
        },
        "predictive": {
          "type": "number",
          "default": 15,
          "description": "Weight percentage for predictive models (0-100)"
        }
      },
      "description": "Weight distribution for signal components"
    },
    "predictive_config": {
      "type": "object",
      "properties": {
        "model_type": {
          "type": "string",
          "enum": [
            "lstm",
            "transformer",
            "ensemble"
          ],
          "default": "ensemble"
        },
        "prediction_horizon": {
          "type": "string",
          "enum": [
            "1h",
            "4h",
            "24h",
            "7d"
          ],
          "default": "24h"
        },
        "confidence_threshold": {
          "type": "number",
          "default": 70
        },
        "use_market_regime": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Predictive model configuration"
    },
    "anomaly_config": {
      "type": "object",
      "properties": {
        "detection_method": {
          "type": "string",
          "enum": [
            "statistical",
            "ml_based",
            "hybrid"
          ],
          "default": "hybrid"
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium"
        },
        "anomaly_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "volume_spike",
              "price_manipulation",
              "whale_activity",
              "flash_crash",
              "pump_dump"
            ]
          },
          "default": [
            "volume_spike",
            "whale_activity",
            "pump_dump"
          ]
        }
      },
      "description": "Anomaly detection configuration"
    },
    "sentiment_config": {
      "type": "object",
      "properties": {
        "news_sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "major_outlets",
            "crypto_specific",
            "social_media"
          ]
        },
        "sentiment_threshold": {
          "type": "number",
          "default": 0.3,
          "description": "Minimum sentiment score to consider (-1 to 1)"
        },
        "include_influencers": {
          "type": "boolean",
          "default": true
        },
        "language_filter": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "en"
          ]
        }
      },
      "description": "Sentiment analysis configuration"
    },
    "onchain_config": {
      "type": "object",
      "properties": {
        "whale_threshold_usd": {
          "type": "number",
          "default": 1000000,
          "description": "Minimum transaction size to track"
        },
        "exchange_flow_importance": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "high"
        },
        "holder_metrics": {
          "type": "boolean",
          "default": true
        },
        "network_health": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "On-chain analysis configuration"
    },
    "signal_thresholds": {
      "type": "object",
      "properties": {
        "strong_buy": {
          "type": "number",
          "default": 80
        },
        "buy": {
          "type": "number",
          "default": 70
        },
        "hold": {
          "type": "number",
          "default": 50
        },
        "sell": {
          "type": "number",
          "default": 40
        },
        "strong_sell": {
          "type": "number",
          "default": 30
        }
      },
      "description": "Confidence thresholds for different signals"
    },
    "indicator_settings": {
      "type": "object",
      "description": "Enabled technical indicators for signal generation",
      "properties": {
        "rsi": {
          "type": "boolean",
          "default": true
        },
        "macd": {
          "type": "boolean",
          "default": true
        },
        "bollinger": {
          "type": "boolean",
          "default": true
        },
        "ema": {
          "type": "boolean",
          "default": true
        },
        "stoch": {
          "type": "boolean",
          "default": true
        },
        "adx": {
          "type": "boolean",
          "default": true
        },
        "sma": {
          "type": "boolean",
          "default": true
        },
        "ao": {
          "type": "boolean",
          "default": true
        },
        "aroon": {
          "type": "boolean",
          "default": true
        },
        "candlestick": {
          "type": "boolean",
          "default": true
        },
        "ichimoku": {
          "type": "boolean",
          "default": true
        },
        "sp500ai": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "refresh_interval_minutes": {
      "type": "number",
      "default": 5,
      "description": "How often to refresh signals (minutes)"
    },
    "notification_on_signal": {
      "type": "boolean",
      "default": true,
      "description": "Send notification when strong signal detected"
    }
  },
  "required": [
    "config_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}